{
  "manifest_version": 3,
  "name": "Letterblurd",
  "short_name": "Letterblurd",
  "version": "1.0.0",
  "description": "Hides Letterboxd ratings until you've rated the film. Form your own opinion. Remember those?",
  "author": "Marino",
  "homepage_url": "https://github.com/marinocom",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Letterblurd",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/film/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
